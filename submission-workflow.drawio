<mxfile host="drawio" type="device"><diagram id="Submission workflow" name="Submission workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="1620" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Physical Plan Submission&lt;/b&gt; · submission and review workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#193443;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="lane0" value="District planner" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#193443;fontColor=#FFFFFF;strokeColor=#193443;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="1540" as="geometry"/></mxCell><mxCell id="lane1" value="App · planner's browser" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#193443;fontColor=#FFFFFF;strokeColor=#193443;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="250" height="1540" as="geometry"/></mxCell><mxCell id="lane2" value="App server" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#193443;fontColor=#FFFFFF;strokeColor=#193443;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="250" height="1540" as="geometry"/></mxCell><mxCell id="lane3" value="ArcGIS Online" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#193443;fontColor=#FFFFFF;strokeColor=#193443;swimlaneFillColor=#F7F9FA;fontStyle=1;fontSize=13;fontFamily=Helvetica;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="250" height="1540" as="geometry"/></mxCell><mxCell id="lane4" value="NLA reviewer" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#193443;fontColor=#FFFFFF;strokeColor=#193443;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1060" y="60" width="250" height="1540" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Sign in&lt;/b&gt;&lt;br&gt;username + password,&lt;br&gt;or organization SSO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Verify the account&lt;/b&gt;&lt;br&gt;privilege “Edit features”&lt;br&gt;(and group, if set)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Portal&lt;/b&gt;&lt;br&gt;token + user profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3F9;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="d1" value="Allowed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFA800;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585" y="225" width="160" height="90" as="geometry"/></mxCell><mxCell id="p1x" value="Sign-in refused,&lt;br&gt;with the reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1F1;strokeColor=#C62828;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="210" height="60" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Drop the plan file&lt;/b&gt;&lt;br&gt;.zip (Shapefile) or .geojson&lt;br&gt;+ optional PDFs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="210" height="70" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Read the file&lt;/b&gt;&lt;br&gt;polygons · coordinate system (.prj)&lt;br&gt;· close open rings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="210" height="70" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Check every value&lt;/b&gt;&lt;br&gt;against the layer's fields;&lt;br&gt;flag self-crossing parcels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="210" height="70" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Duplicate check&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="210" height="50" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Find existing parcels&lt;/b&gt;&lt;br&gt;same UPI, or same shape and&lt;br&gt;position (±1 m, ±1 %)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="545" width="210" height="80" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Physical_Plans&lt;/b&gt;&lt;br&gt;query" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3F9;strokeColor=#0D73B0;fontColor=#110E0E;fontSize=12;fontFamily=Helvetica;spacing=6;" vertex="1" parent=