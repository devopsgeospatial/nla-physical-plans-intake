# --- ArcGIS Online -------------------------------------------------------------
ARCGIS_PORTAL_URL=https://rla.maps.arcgis.com

# Intake layer the app writes to (layer index included). Printed by `npm run provision-layer`.
ARCGIS_FEATURE_LAYER_URL=https://services7.arcgis.com/htgaiKX6RV2DDGgK/arcgis/rest/services/Physical_Plan_Submissions/FeatureServer/0

# Existing reference layer. Only used by provision-layer to copy its spatial reference (TM Rwanda / ITRF2005).
ARCGIS_REFERENCE_LAYER_URL=https://services7.arcgis.com/htgaiKX6RV2DDGgK/arcgis/rest/services/Physical_Plans/FeatureServer/0

# --- User sign-in (OAuth 2.0) ---------------------------------------------------
# Users sign in with their own ArcGIS Online accounts; edits are made with their token.
# Client ID of the OAuth credentials item (Content > New item > Developer credentials > OAuth 2.0 credentials).
ARCGIS_OAUTH_CLIENT_ID=
# Public URL of this app. The redirect URL registered on the OAuth credentials must be <APP_URL>/api/auth/callback.
APP_URL=http://localhost:3000
# Optional: only members of this ArcGIS group may sign in (group id from the group page URL).
ARCGIS_ALLOWED_GROUP_ID=
# Encrypts the session cookie. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# How long a sign-in lasts, in minutes (ArcGIS Online maximum: 20160 = 2 weeks).
SESSION_MINUTES=20160

# --- One-time layer setup only (npm run provision-layer) ------------------------
# A built-in (non-SSO, no MFA) account with Creator + Publisher. Not used by the running app;
# you can clear these after the layer exists.
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
ARCGIS_TOKEN_REFERER=http://localhost:3000

# Optional: geometry service, only used if the layer SR is neither 4326/3857 nor a WKT proj4 can read.
ARCGIS_GEOMETRY_SERVICE_URL=

# --- Upload limits -------------------------------------------------------------
MAX_BOUNDARY_BYTES=10485760
MAX_PDF_BYTES=26214400
MAX_PDF_COUNT=5
