# --- Which app -------------------------------------------------------------------
# The same code runs two apps, each as its own deployment with its own APP_URL:
#   submission (default): district planners upload plans and read NLA's response.
#   review:               NLA reviewers approve plans or return them with comments.
#   home:                 landing page linking to both (needs only the two URLs below).
#   public:               citizens check a parcel (UPI) against approved plans; no sign-in.
#                         Optional: PUBLIC_DISTRICT=muhanga serves one district only,
#                         PUBLIC_WEBMAP_ID, PUBLIC_PLAN_FILTER (default: approval_date IS NOT NULL).
APP_MODE=submission
HOME_APP_URL=https://nla-physical-plans-home.vercel.app
SUBMISSION_APP_URL=https://nla-physical-plans.vercel.app
REVIEW_APP_URL=https://nla-physical-plans-review.vercel.app
PUBLIC_APP_URL=https://nla-physical-plans-public.vercel.app

# --- ArcGIS Online -------------------------------------------------------------
ARCGIS_PORTAL_URL=https://rla.maps.arcgis.com

# The existing feature layer that uploads are appended to (layer index included).
ARCGIS_FEATURE_LAYER_URL=https://services7.arcgis.com/htgaiKX6RV2DDGgK/arcgis/rest/services/Physical_Plans/FeatureServer/0

# Web map shown in the app (basemap + layers as configured in ArcGIS Map Viewer).
ARCGIS_WEBMAP_ID=04d76651f4a046f7be88c7d072780f19

# --- User sign-in (OAuth 2.0) ---------------------------------------------------
# Users sign in with their own ArcGIS Online accounts; edits are made with their token.
# Client ID of the OAuth credentials item (Content > New item > Developer credentials > OAuth 2.0 credentials).
ARCGIS_OAUTH_CLIENT_ID=
# Public URL of this app. The redirect URL registered on the OAuth credentials must be <APP_URL>/api/auth/callback.
APP_URL=http://localhost:3000
# Optional: only members of this ArcGIS group may sign in (group id from the group page URL).
ARCGIS_ALLOWED_GROUP_ID=
# Review app only: members of this ArcGIS group may review (organization administrators always may).
ARCGIS_REVIEWER_GROUP_ID=
# Review app only: submissions created before this day are not listed (the imported Muhanga parcels).
REVIEW_SINCE=2026-10-01
# Encrypts the session cookie. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# How long a sign-in lasts, in minutes (ArcGIS Online maximum: 20160 = 2 weeks).
SESSION_MINUTES=20160

# Optional: geometry service, only used if the layer SR is neither 4326/3857 nor a WKT proj4 can read.
ARCGIS_GEOMETRY_SERVICE_URL=

# --- Upload limits -------------------------------------------------------------
MAX_BOUNDARY_BYTES=10485760
MAX_PDF_BYTES=26214400
MAX_PDF_COUNT=5
